# Base default environment
# Settings module to use
DJANGO_SETTINGS_MODULE='sopds.settings.base'

# Корневая директория проекта задаётся через env var SOPDS_ROOT
# (systemd, docker compose, export), не через .env.
# По умолчанию: /opt/sopds-ng
# Производные пути вычисляются автоматически:
#   DATA_ROOT       = $SOPDS_ROOT/data
#   SECRET_KEY_FILE = $DATA_ROOT/secret_key.txt

# Run in debug mode
DEBUG=False

# Sopds-ng version
SOPDS_VERSION_FILE='version.txt'

# Server log level
SOPDS_SERVER_LOG_LEVEL='WARNING'

# Django database settings
# Default: PostgreSQL (требуется сервер PostgreSQL)
SOPDS_DB_ENGINE='postgres'
SOPDS_DB_NAME=''
SOPDS_DB_USER=''
SOPDS_DB_PASSWORD=''
SOPDS_DB_HOST=''
SOPDS_DB_PORT=''
# Для SQLite (bare-metal, без отдельного сервера):
#   SOPDS_DB_ENGINE='sqlite'
# Для MySQL/MariaDB:
#   SOPDS_DB_ENGINE='mysql'
#   SOPDS_DB_NAME='sopds'
#   SOPDS_DB_USER='root'
#   SOPDS_DB_PASSWORD=''
#   SOPDS_DB_HOST='localhost'
#   SOPDS_DB_PORT='3306'

# Server time zone
TIME_ZONE='Europe/Moscow'

# Path to books directory for Docker deployment
# SOPDS_BOOK_PATH='/books'

# Allowed hosts for production (comma-separated)
# ALLOWED_HOSTS='localhost,127.0.0.1'
